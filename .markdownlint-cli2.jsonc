{
    // All markdownlint rules are enabled by default; only MD013 and MD024 are
    // tuned. Tables and fenced code cannot be wrapped without corrupting them,
    // and a SKILL.md frontmatter `description` must be a single unbroken line
    // to satisfy the Agent Skills format. Prose remains bound to 80 columns.
    // MD024 is restricted to siblings so CHANGELOG.md can repeat the Keep a
    // Changelog section names (Added / Changed / Fixed) under each release.
    "config": {
        "MD013": {
            "line_length": 80,
            "tables": false,
            "code_blocks": false,
            "headings": false
        },
        "MD024": {
            "siblings_only": true
        }
    },
    "ignores": [
        "node_modules/**"
    ]
}
